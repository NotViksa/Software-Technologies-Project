<!DOCTYPE html>
<html lang="bg">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Meeple House</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
    href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&family=Instrument+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
    rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <a class="skip-link" href="#main-content">Към съдържанието</a>

    <header class="site-header">
        <div class="site-header__inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Meeple House, начало">
                <span class="brand__mark" aria-hidden="true">
                    <svg viewBox="0 0 64 64" focusable="false">
                        <circle cx="32" cy="16" r="8.5" fill="currentColor" />
                        <path d="M23 28h18l5 12-5 3v13H23V43l-5-3 5-12Z" fill="currentColor" />
                        <path d="M20 31 9 37l3.5 6.5 9-5M44 31l11 6-3.5 6.5-9-5" fill="currentColor" />
                    </svg>
                </span>
                <span class="brand__word">Meeple<em>House</em></span>
            </a>

            <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
                <span class="nav-toggle__bar"></span>
                <span class="nav-toggle__bar"></span>
                <span class="visually-hidden">Меню</span>
            </button>

            <nav class="site-nav" id="site-nav" aria-label="Основна навигация">
                <a class="site-nav__link" asp-controller="Games" asp-action="Index">Каталог</a>
                @if (User.IsInRole(Roles.Employee) || User.IsInRole(Roles.Manager))
                {
                    <a class="site-nav__link" asp-controller="Dashboard" asp-action="Index">Табло</a>
                }
                <partial name="_LoginPartial" />
            </nav>
        </div>
    </header>

    <main id="main-content" class="site-main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="site-footer__inner">
            <div class="site-footer__brand">
                <span class="brand__word brand__word--footer">Meeple<em>House</em></span>
                <address>
                    бул. Някъде 123<br />
                    София
                </address>
            </div>
            <div class="site-footer__block">
                <span class="footer-label">Работно време</span>
                <span class="footer-value">10:00 – 23:00</span>
            </div>
            <div class="site-footer__block">
                <span class="footer-label">Навигация</span>
                <a asp-controller="Games" asp-action="Index">Каталог</a>
                @if (User.IsInRole(Roles.Employee) || User.IsInRole(Roles.Manager))
                {
                    <a asp-controller="Dashboard" asp-action="Index">Табло</a>
                }
            </div>
        </div>
        <div class="site-footer__bottom">
            <span>© @DateTime.Now.Year Meeple House</span>
            <span>Софтуерни технологии</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
