@model GameListItemDto

<div class="card h-100 game-card">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
            <h5 class="card-title mb-0">@Model.Title</h5>
            <span class="badge bg-secondary">@Model.Category</span>
        </div>
        <p class="text-muted small mb-3">
            @Model.MinPlayers-@Model.MaxPlayers играчи · @Model.DurationMinutes мин · @Model.Complexity
        </p>
        <div class="mt-auto d-flex justify-content-between align-items-center">
            @if (Model.AvailableCopies > 0)
            {
                <span class="badge bg-success">@Model.AvailableCopies налични</span>
            }
            else
            {
                <span class="badge bg-secondary">Няма наличен</span>
            }
            <a class="btn btn-sm btn-outline-primary" asp-controller="Games" asp-action="Details" asp-route-id="@Model.Id">Детайли</a>
        </div>
    </div>
</div>
