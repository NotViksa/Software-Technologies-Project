@model GamesIndexViewModel
@{
    ViewData["Title"] = "Каталог";
    var countLabel = Model.Games.Count == 1 ? "игра" : "игри";
}

<section class="catalogue-head" aria-labelledby="catalogue-title">
    <div>
        <h1 id="catalogue-title">Каталог</h1>
        <p class="catalogue-count"><strong>@Model.Games.Count</strong> @countLabel</p>
    </div>
</section>

<form method="get" class="filter-bar">
    <div class="field">
        <label for="search">Търсене</label>
        <input id="search" name="search" value="@Model.Search" autocomplete="off" />
    </div>
    <div class="field">
        <label for="category">Категория</label>
        <select id="category" name="category">
            <option value="">Всички</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category" selected="@(category == Model.Category)">@category</option>
            }
        </select>
    </div>
    <button class="button button--primary" type="submit">Покажи</button>
</form>

@if (Model.Games.Count == 0)
{
    <div class="empty-state">
        <p>Няма игри по тези критерии.</p>
        <a class="text-link" asp-controller="Games" asp-action="Index">Изчисти филтрите</a>
    </div>
}
else
{
    <div class="game-grid">
        @foreach (var game in Model.Games)
        {
            <partial name="_GameCard" model="game" />
        }
    </div>
}
