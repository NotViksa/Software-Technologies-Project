@page
@model BoardGameCafe.Web.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<section class="auth-page">
    <div class="auth-card">
        <h1>Вход</h1>
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="form-error"></div>

            <div class="field">
                <label asp-for="Input.Email">Имейл</label>
                <input asp-for="Input.Email" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="form-error"></span>
            </div>

            <div class="field">
                <label asp-for="Input.Password">Парола</label>
                <input asp-for="Input.Password" autocomplete="current-password" />
                <span asp-validation-for="Input.Password" class="form-error"></span>
            </div>

            <label class="check">
                <input id="Input_RememberMe" name="Input.RememberMe" type="checkbox" value="true" @(Model.Input.RememberMe ? "checked" : null) />
                <input name="Input.RememberMe" type="hidden" value="false" />
                <span>Запомни ме</span>
            </label>

            <button class="button button--primary" type="submit">Вход</button>
        </form>

        <p class="auth-switch">Нямаш профил? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Регистрация</a></p>

        @if (Model.ExternalLogins.Count > 0)
        {
            <div class="auth-divider"><span>или</span></div>
            <form method="post" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" class="auth-form">
                @foreach (var provider in Model.ExternalLogins)
                {
                    <button type="submit" class="button button--ghost" name="provider" value="@provider.Name">@provider.DisplayName</button>
                }
            </form>
        }
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
